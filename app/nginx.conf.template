# `/api/v1` now requires a login session for everything but `POST
# /auth/login` and the health/ready probes (issue #96), but this - the only
# boundary actually exposed to the host (see docker-compose.yml's
# `WEB_BIND_HOST`/`WEB_PORT`) - is still the right place for a per-client
# quota: uploads, downloads and run creation (which spends
# `OPENROUTER_API_KEY` budget) shouldn't let one *authenticated* client
# exhaust connections or LLM spend either.
#
# `burst`/`limit_conn` raised from 30/20 (issue #106): a single multi-file
# source upload in this 4-person lab - each file firing its own
# upload+attach request pair, each attach triggering its own list/detail
# refetch - could legitimately burst past the old limits, tripping this
# rate limiter's plain-HTML default error page (not JSON) and, before
# issue #106's other two fixes, crashing the SPA. The debounced
# invalidation and non-destructive `throwOnError` from that issue reduce
# how much a normal upload burst adds, but the limit itself is still sized
# for a public multi-tenant API rather than this lab's actual traffic.
limit_req_zone $binary_remote_addr zone=api_req:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=api_conn:10m;
# A tighter, dedicated backstop for the login endpoint itself (issue #96):
# it's the one route reachable with no session at all, so it's the only
# route a credential-stuffing/brute-force attempt against this stack's 4
# accounts could actually hit. `burst=5` absorbs a user mistyping their
# password a couple of times in a row without a hard lockout.
limit_req_zone $binary_remote_addr zone=login_req:10m rate=5r/m;

server {
    # 8080, not 80: the container runs as the non-root `nginx` user (see
    # app/Dockerfile), which can't bind a privileged (<1024) port.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Exact match, so this wins over the general `/api/` prefix location
    # below regardless of block order (issue #96's login brute-force
    # backstop).
    location = /api/v1/auth/login {
        limit_req zone=login_req burst=5 nodelay;

        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        # `burst` absorbs a page load's natural cluster of requests;
        # `nodelay` serves the burst immediately instead of pacing it out
        # (this is a spend/DoS backstop, not a fairness scheduler). Doesn't
        # apply to the SSE stream endpoint (`/runs/{id}/events/stream`),
        # which needs one long-lived connection per open runs view - that's
        # bounded separately by `limit_conn` below and by the DB pool fix
        # for issue #46.
        limit_req zone=api_req burst=60 nodelay;
        # Caps concurrent in-flight requests (including open SSE streams)
        # per client IP - the thing issue #46 warned can exhaust the DB
        # pool at ~15 concurrent streams. Raised from 20 (issue #106) to
        # leave headroom above that DB-pool-driven SSE cap for a burst of
        # ordinary in-flight upload/refetch requests too.
        limit_conn api_conn 40;

        # Issue #47: nginx's own default (1m) is far below the API's
        # `MAX_UPLOAD_MB` (200m default) - every RAG source PDF over 1 MB
        # was rejected by nginx before FastAPI's own limit/413 handling
        # (`api/application/files.py:_HashingLimitedStream`) ever ran. Kept
        # in lockstep with the API's limit via envsubst at container start
        # (see `app/Dockerfile`); `${MAX_UPLOAD_MB}` is substituted from the
        # `web` service's own env var, matching `x-app-env`'s value.
        client_max_body_size ${MAX_UPLOAD_MB}m;
        # Stream the body straight to the upstream instead of spooling the
        # whole (up to 200 MB) request to disk here first.
        proxy_request_buffering off;
        # The default 60s is fine for the SSE stream (sse-starlette pings
        # every 15s) but too tight for a large upload over a slow link, and
        # for `proxy_send_timeout` while nginx is still streaming a big body
        # to the API - make both explicit rather than relying on the default.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;

        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
