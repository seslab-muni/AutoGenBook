# Issue #50: `/api/v1` has no authentication or per-client quota of its own
# (see `api/main.py`'s module docstring and `docs/OPERATIONS.md`) - uploads,
# downloads and run creation (which spends `OPENROUTER_API_KEY` budget) are
# all reachable by anyone who can reach this proxy. Until the backend grows
# real auth, throttle at this, the only boundary actually exposed to the
# host (see docker-compose.yml's `WEB_BIND_HOST`/`WEB_PORT`), so a single
# client can't exhaust connections or LLM spend.
limit_req_zone $binary_remote_addr zone=api_req:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=api_conn:10m;

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # `burst` absorbs a page load's natural cluster of requests;
        # `nodelay` serves the burst immediately instead of pacing it out
        # (this is a spend/DoS backstop, not a fairness scheduler). Doesn't
        # apply to the SSE stream endpoint (`/runs/{id}/events/stream`),
        # which needs one long-lived connection per open runs view - that's
        # bounded separately by `limit_conn` below and by the DB pool fix
        # for issue #46.
        limit_req zone=api_req burst=30 nodelay;
        # Caps concurrent in-flight requests (including open SSE streams)
        # per client IP - the thing issue #46 warned can exhaust the DB
        # pool at ~15 concurrent streams.
        limit_conn api_conn 20;

        # Issue #47: nginx's own default (1m) is far below the API's
        # `MAX_UPLOAD_MB` (200m default) - every RAG source PDF over 1 MB
        # was rejected by nginx before FastAPI's own limit/413 handling
        # (`api/application/files.py:_HashingLimitedStream`) ever ran. Kept
        # in lockstep with the API's limit via envsubst at container start
        # (see `app/Dockerfile`); `${MAX_UPLOAD_MB}` is substituted from the
        # `web` service's own env var, matching `x-app-env`'s value.
        client_max_body_size ${MAX_UPLOAD_MB}m;
        # Stream the body straight to the upstream instead of spooling the
        # whole (up to 200 MB) request to disk here first.
        proxy_request_buffering off;
        # The default 60s is fine for the SSE stream (sse-starlette pings
        # every 15s) but too tight for a large upload over a slow link, and
        # for `proxy_send_timeout` while nginx is still streaming a big body
        # to the API - make both explicit rather than relying on the default.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;

        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
