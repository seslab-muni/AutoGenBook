# Base URL the frontend's API client (src/api/client.ts) prepends to spec paths,
# which already carry the full /api/v1/... prefix. Defaults to the page's own
# origin when unset, relying on the dev-server / nginx proxy below to route
# /api/* to the backend. Only set this to point at a different host entirely.
VITE_API_BASE_URL=

# Target for the Vite dev-server's /api proxy (see vite.config.ts).
# Point this at a locally running api/ service, or leave unset to use the Docker Compose default.
VITE_API_PROXY_TARGET=http://localhost:8080

# Set to 1 to run `pnpm dev` against the in-browser MSW mock API instead of a
# real backend (see src/mocks/browser.ts). Unset/0 talks to VITE_API_PROXY_TARGET.
VITE_USE_MOCKS=0
