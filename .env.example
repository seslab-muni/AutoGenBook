# Web port. FastAPI and PostgreSQL remain internal to Docker. Bound to
# WEB_BIND_HOST (127.0.0.1 by default) - /api/v1 has no authentication
# (issue #50), so this stays loopback-only unless you put a real auth/proxy
# layer in front and deliberately set WEB_BIND_HOST=0.0.0.0.
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8080

POSTGRES_DB=autogenbook
POSTGRES_USER=autogenbook
POSTGRES_PASSWORD=change-this-password

OPENROUTER_API_KEY=
AUTOGENBOOK_LLM_BASE_URL=
AUTOGENBOOK_LLM_API_KEY=
# Base model used everywhere no more specific override is given. Defaults to
# openai/gpt-5-mini; set this to a model id your endpoint actually serves.
AUTOGENBOOK_LLM_MODEL=
# Cheaper model used only when AUTOGENBOOK_FORCE_MINI_MODEL=1; falls back to
# AUTOGENBOOK_LLM_MODEL if left empty.
AUTOGENBOOK_LLM_MINI_MODEL=
# Set to 1 to force AUTOGENBOOK_LLM_MINI_MODEL for every call, for low-cost
# dev/test runs. Leave unset (or 0) in production.
AUTOGENBOOK_FORCE_MINI_MODEL=
TAVILY_API_KEY=
MCP_GATEWAY_ENABLE=0
# OCR fallback for PDFs with no text layer (e.g. scanned documents), via
# Tesseract + poppler (both installed in the image). Set to 0 to disable.
AUTOGENBOOK_KB_OCR=1
AUTOGENBOOK_KB_OCR_LANG=eng

# Object storage (MinIO), internal-only; uploads/downloads are proxied through the API.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=autogenbook
S3_SECRET_KEY=change-this-secret
S3_BUCKET=autogenbook
MAX_UPLOAD_MB=200

# Generation worker
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_S=2
RUNS_RETENTION_DAYS=30
# Seconds since last heartbeat before a run is considered stale and requeued
# (api/worker/__main__.py, SqlAlchemyRunQueue.requeue_stale).
WORKER_STALE_S=300
# Hard wall-clock timeout (seconds) for a single CLI subprocess run before the
# worker kills it; 21600 (6h) comfortably covers a full-size book run while
# still bounding a truly stuck one (issue #80).
CLI_RUN_TIMEOUT_S=21600
# Grace period (seconds) between SIGTERM and SIGKILL when cancelling or timing
# out a running CLI subprocess.
CLI_CANCEL_GRACE_S=15
# Whether the worker rewrites the generated document's author line from the
# project's stored authors after a run completes. Set to 0 to leave whatever
# author line the CLI itself wrote.
REWRITE_AUTHOR_LINE=1
